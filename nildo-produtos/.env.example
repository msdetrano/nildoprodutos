# Necessário para habilitar /gestao em produção (não compartilhar/publicar os valores reais)
ADMIN_PASSWORD=troque-por-uma-senha-bem-forte
SESSION_SECRET=troque-por-um-segredo-aleatorio-de-mais-de-32-caracteres

# Obrigatório para SALVAR edições na Vercel (crie um Redis Upstash e cole as credenciais REST)
